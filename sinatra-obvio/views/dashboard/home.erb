<div class="dashboard-container">
    <div class="card">
        <span class="text-xl font-bold">
            <%= "$#{amount_format(current_account&.balance)}" %> 
        </span>
        <div class="btn-group">
            <a href="/dashboard/cargar" class="btn btn--round btn--orangeBG grayOUTLINE">Cargar dinero</a>
            <a href="/dashboard/contactos" class="btn btn--round btn--grayBG">Transferir</a>
        </div>
    </div>
    
    <div class="flex flex-col w-full gap-m">
        <h2 class="section-header">Últimos movimientos</h2>
        <input type="text" placeholder="Buscar" class="input input--search">
           
        <div class="list list--scrollable movimientos-list w-full">
			<% if @recent_transactions.empty? %>
				<div class="empty-state flex justify-center items-center text-gray-lighter text-center text-l">
					<p>Aún no tenés movimientos.</p>
				</div>
			<% else %>
				<% @recent_transactions.each do |transaction| %>
					<% is_income = transaction.target_account_id == current_account.id %>
					<% other_account = is_income ? transaction.source_account : transaction.target_account %>

					<a href="/dashboard/receipt/<%= transaction.transaction_number %>" class="movimiento list-item" data-name="<%= "#{other_account.user.first_name} #{other_account.user.last_name}".downcase %>">
						<div class="persona">
							<div class="persona__avatar">
								<img src="/assets/defaultAvatar.svg" alt="Avatar" class="avatar avatar--s">
							</div>
							<div class="persona__datosPersona">
								<p class="name"><%= other_account.user.first_name %> <%= other_account.user.last_name %></p>
								<p class="email"><%= other_account.user.email %></p>
							</div>
						</div>
						<div class="movimiento__detalles">
							<p class="text-m">
								<% if is_income %> 
									<span class="text-green font-bold">+ $<%= amount_format(transaction.amount) %> </span>
								<% else %>
									<span class="text-red font-bold">- $<%= amount_format(transaction.amount) %> </span>
								<% end %>
							</p>
						<span class="text-s text-secondary">
							<%= format_date(transaction.date) %> - <%= format_time(transaction.time) %>
						</span>
						</div>
					</a>
				<% end %>
			<% end %>
		</div>
    </div>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const inputSearch = document.querySelector('.input--search');
    const movimientos = document.querySelectorAll('.movimiento');

    inputSearch.addEventListener('input', function() {
      const filtro = this.value.toLowerCase().trim();

      movimientos.forEach(movimiento => {
        const nombre = movimiento.getAttribute('data-name');
        if (nombre.includes(filtro)) {
          movimiento.style.display = '';
        } else {
          movimiento.style.display = 'none';
        }
      });
    });
  });
</script>
