<div class="dashboard-container">
  <div class="w-full h-full flex flex-col grayBG p-6">
    <div class="w-full flex justify-between items-center mb-6">
      <a href="/dashboard/resumen/<%= @prev_year %>/<%= @prev_month %>" class="text-primary text-3xl">&larr;</a>

      <% mes_nombre = Date::MONTHNAMES[@month] || "Mes inválido" %>
      <div class="text-4xl font-bold text-white"><%= mes_nombre %> <%= @year || '' %></div>

      <% if @next_year && @next_month %>
        <a href="/dashboard/resumen/<%= @next_year %>/<%= @next_month %>" class="text-primary text-3xl">&rarr;</a>
      <% else %>
        <span class="text-primary text-3xl opacity-50 cursor-not-allowed">&rarr;</span>
      <% end %>
    </div>

    <div class="text-center spacing-m mb-8">
      <p class="text-white text-2xl font-semibold">Tu cuenta tuvo <%= @transactions.count %> movimientos</p>
      <p class="text-primary text-xl mt-2">Recibiste: <strong>$<%= @income_total %></strong></p>
      <p class="text-primary text-xl">Gastos: <strong>$<%= @expense_total %></strong></p>
    </div>

    <div class="list list--scrollable">
      <% @transactions.each do |tx| %>
        <a href="/receipt/<%= tx.id %>" class="movimiento">
          <div class="movimiento__detalles">
            <div class="persona">
              <div class="persona__avatar">
                <img src="/assets/icons/defaultAvatar.svg" class="avatar avatar--xs">
              </div>
              <div class="persona__datosPersona">
                <span class="name text-lg">
                  <%= tx.source_account_id == current_user.account.id ? tx.target_account.user.full_name : tx.source_account.user.full_name %>
                </span>
                <span class="email text-sm">
                  <%= tx.source_account_id == current_user.account.id ? tx.target_account.user.email : tx.source_account.user.email %>
                </span>
              </div>
            </div>
            <div class="text-right text-primary">
              <p class="<%= tx.source_account_id == current_user.account.id ? 'text-warning text-lg' : 'text-lg' %>">
                <%= tx.source_account_id == current_user.account.id ? '-' : '' %>$<%= tx.amount %>
              </p>
              <p class="text-secondary text-s">
                <%= tx.date.strftime('%-d/%-m') %> - <%= tx.time.strftime('%H:%Mhs') %>
              </p>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</div>
